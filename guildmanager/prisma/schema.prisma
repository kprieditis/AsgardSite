generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?

  accounts Account[]
  sessions Session[]
  profile  Profile?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Profile {
  id              String            @id @default(cuid())
  userId          String            @unique @map("user_id")
  displayName     String?           @map("display_name")
  rsiHandle       String?           @map("rsi_handle")
  timezone        String?
  primaryActivity String?           @map("primary_activity")
  primaryRole     String?           @map("primary_role")
  bio             String?
  visibility      ProfileVisibility @default(MEMBERS)
  communityRank   CommunityRank     @default(RECRUIT)
  siteRole        SiteRole          @default(APPLICANT)
  division        Division?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS
  PRIVATE
}

enum CommunityRank {
  RECRUIT
  MEMBER
  OPERATOR
  VETERAN
  SPECIALIST
  SQUAD_LEADER
  OFFICER
  HIGH_COMMAND
  FOUNDER
}

enum SiteRole {
  APPLICANT
  MEMBER
  EVENT_LEADER
  RECRUITER
  MODERATOR
  OFFICER
  ADMIN
  OWNER
}

enum Division {
  COMMAND
  FLEET_OPERATIONS
  GROUND_FORCES
  LOGISTICS
  INDUSTRY
  MEDICAL
  RECON
  SECURITY
  TRAINING
}